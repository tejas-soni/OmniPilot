{
  "name": "omnipilot-vscode",
  "displayName": "OmniPilot - Bring Your Own Model",
  "description": "OmniPilot AI coding assistant — connect any OpenAI-compatible API to VS Code",
  "version": "1.1.0",
  "publisher": "omnipilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejas-soni/OmniPilot"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnipilot-sidebar",
          "title": "OmniPilot",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "omnipilot-sidebar": [
        {
          "type": "webview",
          "id": "omnipilot.chatView",
          "name": "AI Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "omnipilot.newChat",
        "title": "OmniPilot: New Chat"
      },
      {
        "command": "omnipilot.openSettings",
        "title": "OmniPilot: Open Settings"
      }
    ],
    "configuration": {
      "title": "OmniPilot",
      "properties": {
        "omnipilot.providers": {
          "type": "array",
          "default": [],
          "description": "List of AI providers. Each item: { id, name, baseUrl, apiKey, models }",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "models": {
                "type": "string",
                "description": "Comma-separated model names, or leave blank to auto-fetch"
              }
            }
          }
        },
        "omnipilot.activeProviderId": {
          "type": "string",
          "default": "",
          "description": "The ID of the currently active provider"
        },
        "omnipilot.activeModel": {
          "type": "string",
          "default": "",
          "description": "The currently selected model name"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node ../omnipilot-core/node_modules/esbuild/bin/esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
